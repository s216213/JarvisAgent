<Window
    x:Class="JarvisDesktop.HudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Jarvis">
    <Border Background="#101820" BorderBrush="#1E3344" BorderThickness="1" CornerRadius="12" Padding="16,28,16,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#7FDBFF" />
            <StackPanel Grid.Column="1" Spacing="8" Margin="16,0,0,0">
                <TextBlock x:Name="Clock" Foreground="#7FDBFF" FontFamily="Consolas" FontSize="13" Text="00:00" />
                <TextBlock x:Name="Vitals" Foreground="#8AA0B2" FontFamily="Consolas" FontSize="13" Text="CPU —   RAM —   BAT —" TextWrapping="Wrap" />
                <TextBlock x:Name="Alert" Foreground="#E8A54B" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="Mission" Foreground="#7FDBFF" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="Status" Foreground="#8AA0B2" FontFamily="Consolas" FontSize="13" Text="cisza" />
                <TextBlock x:Name="Line" Foreground="#E7F6FF" FontSize="18" TextWrapping="Wrap" />
                <StackPanel x:Name="Consent" Orientation="Horizontal" Visibility="Collapsed" Spacing="8">
                    <TextBlock x:Name="ConsentBody" Foreground="#E8A54B" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" MaxWidth="280" VerticalAlignment="Center" />
                    <Button Content="Tak" Click="Accept" Background="Transparent" Foreground="#E8A54B" BorderBrush="#E8A54B" BorderThickness="1" Padding="16,8" />
                    <Button Content="Nie" Click="Reject" Background="Transparent" Foreground="#FF6B6B" BorderBrush="#FF6B6B" BorderThickness="1" Padding="16,8" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
