<Application
    x:Class="JarvisDesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="Bg" Color="#070B10" />
            <SolidColorBrush x:Key="Panel" Color="#101820" />
            <SolidColorBrush x:Key="Accent" Color="#7FDBFF" />
            <SolidColorBrush x:Key="Text" Color="#E7F6FF" />
            <SolidColorBrush x:Key="Muted" Color="#8AA0B2" />
            <SolidColorBrush x:Key="Warn" Color="#E8A54B" />
            <SolidColorBrush x:Key="Line" Color="#1E3344" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
