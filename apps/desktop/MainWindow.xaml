<Window
    x:Class="JarvisDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Jarvis"
    Width="720"
    Height="480">
    <Grid Background="#070B10" Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Jarvis" Foreground="#7FDBFF" FontSize="28" />
            <TextBlock x:Name="VoiceStatus" Foreground="#8AA0B2" />
            <TextBox x:Name="Api" Text="http://localhost:8080" />
            <TextBox x:Name="Code" PlaceholderText="Kod parowania" />
            <Button Content="Sparuj ten komputer" Click="Pair" />
            <TextBlock x:Name="Hint" Foreground="#E7F6FF" TextWrapping="Wrap" />
            <TextBox x:Name="Palette" PlaceholderText="Alt+Space: notatka, program, polecenie" KeyDown="PaletteKey" />
            <TextBlock x:Name="Log" Foreground="#8AA0B2" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
