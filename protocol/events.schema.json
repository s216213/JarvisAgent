{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JarvisEvent",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "user_text" },
        "text": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "presence" },
        "speech": { "type": "boolean" },
        "idle": { "type": "boolean" },
        "away": { "type": "boolean" },
        "app": { "type": "string" },
        "window": { "type": "string" },
        "telemetry": { "type": "object" },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    {
      "type": "object",
      "required": ["type", "id", "accept"],
      "properties": {
        "type": { "const": "confirm" },
        "id": { "type": "string" },
        "accept": { "type": "boolean" },
        "via": { "enum": ["voice", "button", "text"] }
      }
    },
    {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "token" },
        "text": { "type": "string" },
        "final": { "type": "boolean" }
      }
    },
    {
      "type": "object",
      "required": ["type", "widget"],
      "properties": {
        "type": { "const": "widget" },
        "widget": { "type": "object" }
      }
    },
    {
      "type": "object",
      "required": ["type", "id", "summary"],
      "properties": {
        "type": { "const": "confirm_request" },
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["type", "device_id"],
      "properties": {
        "type": { "const": "move_presence" },
        "device_id": { "type": "string" },
        "whole_task": { "type": "boolean" }
      }
    },
    {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "quiet" },
        "text": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["type", "title"],
      "properties": {
        "type": { "const": "digest" },
        "app": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["type", "nodes"],
      "properties": {
        "type": { "const": "space_scene" },
        "nodes": { "type": "array" },
        "edges": { "type": "array" },
        "ghost": { "type": "array" },
        "map": { "type": "object" },
        "text": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["type", "body"],
      "properties": {
        "type": { "const": "apply_patch" },
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "done" }
      }
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "run" },
        "id": { "type": "string" },
        "command": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "capture" },
        "id": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["type", "id", "output"],
      "properties": {
        "type": { "const": "tool_result" },
        "id": { "type": "string" },
        "output": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "clipboard" },
        "text": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "clipboard_set" },
        "text": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "desktop_mode" },
        "name": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "board" }
      }
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "hud_state" },
        "cpu": { "type": ["number", "null"] },
        "ram": { "type": ["number", "null"] },
        "battery": { "type": ["number", "null"] },
        "network": { "type": "string" },
        "alert": { "type": "string" },
        "mission": { "type": "string" }
      }
    }
  ]
}
