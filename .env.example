# Skopiuj do .env. Ten plik zostaje w gicie, .env nie.
# Przy cargo run (poza Dockerem) niepuste wartości stąd wygrywają z data/jarvis.env.

JARVIS_WEB_ORIGIN=http://localhost:5173
JARVIS_COOKIE_SECURE=0
JARVIS_WEB_PASSWORD=jarvis
JARVIS_PAIR_CODE=jarvis
PORT=8080

# JARVIS_DATA=data
